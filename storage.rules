rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isValidImage() {
      return request.resource.contentType.matches('image/jpeg') ||
             request.resource.contentType.matches('image/png') ||
             request.resource.contentType.matches('image/webp');
    }
    function isValidSize() {
      return request.resource.size <= 5 * 1024 * 1024;
    }
    match /evidence/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage() && isValidSize();
    }
    match /avatars/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage() && isValidSize();
    }
    match /missions/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidImage() && isValidSize();
    }
  }
}

